{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .github/hooks/scripts/pre-bash-safety.sh",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .github/hooks/scripts/pre-create-results.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .github/hooks/scripts/agent-stop-check.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
